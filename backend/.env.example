# Upstage Solar API (대화·구조화) — provider "solar" (Solar Pro)
UPSTAGE_API_KEY=up_xxxxxxxxxxxxxxxxxxxx
SOLAR_MODEL=solar-pro2

# LG K-EXAONE (Friendli dedicated endpoint, OpenAI 호환) — provider "kexaone"
# KEXAONE_API_KEY = 발급받은 키(flp_ 로 시작), KEXAONE_ENDPOINT = 배포된 Endpoint ID
KEXAONE_API_KEY=flp_xxxxxxxxxxxxxxxxxxxx
KEXAONE_ENDPOINT=xxxxxxxxxxxx
KEXAONE_BASE_URL=https://api.friendli.ai/dedicated/v1

# 국가법령정보 OPEN API (open.law.go.kr) — 법령 근거·기한 grounding
# OC = 가입 ID. 호출 서버 IP/도메인 사전 등록 필요.
LAW_OC=ol_xxxxxxxxxxxxxxxx

# 공공데이터포털 (data.go.kr / odcloud) — 보조금24·중앙부처복지서비스 grounding
# 일반/Decoding 인증키.
DATA_GO_KR_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
